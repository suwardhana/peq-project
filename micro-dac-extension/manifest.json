{
  "manifest_version": 3,
  "name": "Hangout/Squiglink PEQ to CrinEar Protocol Micro",
  "version": "2.0.0",
  "description": "Edit the CrinEar Protocol Micro 8-band PEQ over WebHID, and send EQ from eq.hangout.audio / squig.link \u2014 no backend needed.",
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Protocol Micro PEQ"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eq.hangout.audio/*",
        "https://*.hangout.audio/*",
        "https://squig.link/*",
        "https://*.squig.link/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "peq-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
