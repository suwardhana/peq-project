{
  "manifest_version": 3,
  "name": "Squiglink PEQ to Cayin RU3",
  "version": "1.0.0",
  "description": "Send the active 10-band parametric EQ from Squiglink directly to the local Cayin RU3 v2 backend.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Squiglink PEQ to Cayin RU3"
  },
  "content_scripts": [
    {
      "matches": [
        "https://squig.link/*",
        "https://*.squig.link/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "peq-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
